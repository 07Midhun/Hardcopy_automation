# ==============================================================================
# AI Document Intelligence - Environment Configuration
# ==============================================================================

# Application Environment
FLASK_APP=backend.run:app
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-1234567890abcdef
DEBUG=True
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Local SQLite default (zero-configuration, no server required):
DATABASE_URL=sqlite:///storage/doc_intelligence.db
# For PostgreSQL (Docker / Cloud / Local Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doc_intelligence

# Background Task Queue (Celery + Redis)
# CELERY_ALWAYS_EAGER=True runs tasks synchronously in-process when Redis is not running
CELERY_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Storage Configuration
# STORAGE_BACKEND: 's3' or 'local'
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage/uploads
TEMP_DIR=storage/temp
EXPORTS_DIR=storage/exports

# AWS S3 Configuration (Required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-doc-intelligence-storage
S3_PRESIGNED_EXPIRATION=3600

# AI Extraction Provider Configuration
# AI_PROVIDER: 'azure', 'vision_openai', 'vision_gemini', 'vision_claude', 'hybrid', 'fallback'
AI_PROVIDER=fallback
CONFIDENCE_THRESHOLD=0.75

# Azure AI Document Intelligence Credentials (if AI_PROVIDER=azure or hybrid)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key

# OpenAI Vision API (if AI_PROVIDER=vision_openai or hybrid)
OPENAI_API_KEY=your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o

# Google Gemini Vision API (if AI_PROVIDER=vision_gemini or hybrid)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-3.8-flash

# Processing Parameters
BATCH_SIZE=100
MAX_CONCURRENT_WORKERS=4
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2
RETRY_DELAY_SECONDS=5

# Document Security & Constraints
MAX_CONTENT_LENGTH=104857600  # 100 MB max upload size
ALLOWED_EXTENSIONS=pdf,zip
